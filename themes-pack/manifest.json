{
  "id": "themes-pack",
  "name": "Onda Themes Pack",
  "version": "1.0.0",
  "description": "A curated pack of 5 dark color themes for Onda — Nord Aurora, Solarized Deep, Tokyo Night, Gruvbox Material, and Catppuccin Mocha. Adds a command to cycle through them and a picker to jump to any theme.",
  "author": {
    "name": "Mario Mosca",
    "url": "https://github.com/mariomosca"
  },
  "main": "main.js",
  "capabilities": [
    "themes",
    "commands",
    "keybindings",
    "storage",
    "dialog",
    "notifications"
  ],
  "activationEvents": ["onStartup"],
  "contributes": {
    "commands": [
      {
        "id": "themes-pack.cycle",
        "title": "Cycle Through Pack Themes",
        "category": "Themes",
        "icon": "palette"
      },
      {
        "id": "themes-pack.pick",
        "title": "Pick a Theme…",
        "category": "Themes",
        "icon": "palette"
      }
    ],
    "keybindings": [
      {
        "command": "themes-pack.cycle",
        "key": "Cmd+Shift+T",
        "when": "always",
        "label": "Cycle Pack Themes"
      }
    ],
    "themes": [
      {
        "id": "nord-aurora",
        "name": "Nord Aurora",
        "isDark": true,
        "colors": {
          "bgPrimary": "#2e3440",
          "bgSecondary": "#3b4252",
          "bgTertiary": "#434c5e",
          "bgHover": "#4c566a",
          "bgActive": "#545d70",
          "textPrimary": "#eceff4",
          "textSecondary": "#d8dee9",
          "textMuted": "#7b88a1",
          "textInverse": "#2e3440",
          "borderPrimary": "#434c5e",
          "borderSecondary": "#3b4252",
          "borderFocus": "#88c0d0",
          "accent": "#88c0d0",
          "accentHover": "#8fbcbb",
          "accentMuted": "#5e81ac",
          "success": "#a3be8c",
          "warning": "#ebcb8b",
          "error": "#bf616a",
          "info": "#81a1c1",
          "terminal": "#272c36",
          "selection": "rgba(136, 192, 208, 0.22)"
        }
      },
      {
        "id": "solarized-deep",
        "name": "Solarized Deep",
        "isDark": true,
